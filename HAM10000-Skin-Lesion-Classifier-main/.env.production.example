# Copy to .env.production and replace with real production values.
XDERMA_API_KEY=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=https://your-xderma-app.example.com
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_REFERER=https://your-xderma-app.example.com
OPENROUTER_TITLE=XDerma
OPENROUTER_TIMEOUT_SECONDS=30
